# Скопируйте значения в Railway → Project → Variables (или `railway variables`).
# DATABASE_URL Railway подставит сам из плагина Postgres — не копируйте вручную.

NODE_ENV=production
# PORT задаёт Railway автоматически — не фиксируйте.

LOG_LEVEL=info
CORS_ORIGINS=*

# Обязательно: в production приложение не стартует с дефолтным секретом и требует 32+ символа.
# Сгенерируйте: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_TTL=24h

# Открывает POST /auth/dev-token — нужно демо-странице и smoke-тесту.
# Это осознанный компромисс публичного тестового стенда: токен выдаётся на любой userId
# и роль service, то есть авторизация на стенде фактически отключена.
# На реальном проде — false; приложение предупредит об этом в логах старта.
AUTH_DEV_TOKENS_ENABLED=true

NOTIFICATIONS_RATE_LIMIT=10
NOTIFICATIONS_RATE_WINDOW_MS=60000
NOTIFICATIONS_DEDUP_WINDOW_MS=300000

WS_PATH=/ws/notifications
WS_BACKLOG_BATCH_SIZE=100
WS_BACKLOG_MAX_PAGES=10
WS_ACK_TIMEOUT_MS=5000
SWEEPER_INTERVAL_MS=15000
SWEEPER_MIN_AGE_MS=30000
SWEEPER_ENABLED=true
CRON_ENABLED=true

DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000
PARTITION_LOOKAHEAD_MONTHS=2
RETENTION_MONTHS=6
RETENTION_ENABLED=false
