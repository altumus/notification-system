# Режим и HTTP
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=*

# PostgreSQL
DATABASE_URL=postgresql://notifications:notifications@localhost:5432/notifications
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# JWT (в production минимум 32 байта, без дефолта — см. коммит 20)
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_TTL=24h
AUTH_DEV_TOKENS_ENABLED=true

# Бизнес-правила уведомлений
NOTIFICATIONS_RATE_LIMIT=10
NOTIFICATIONS_RATE_WINDOW_MS=60000
NOTIFICATIONS_DEDUP_WINDOW_MS=300000

# WebSocket / delivery
WS_PATH=/ws/notifications
WS_BACKLOG_BATCH_SIZE=100
SWEEPER_INTERVAL_MS=15000

# Партиции и retention
PARTITION_LOOKAHEAD_MONTHS=2
RETENTION_MONTHS=6
RETENTION_ENABLED=false

# Опционально: горизонтальное масштабирование Socket.IO
# REDIS_URL=redis://localhost:6379

# Метрики
METRICS_ENABLED=true
