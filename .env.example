# Режим и HTTP
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=*

# PostgreSQL
# Хост-порт 5433 (не 5432!) — так проброшен postgres в docker-compose.yml, чтобы не
# конфликтовать с локальным Postgres на машине разработчика. Внутри сети compose (для
# сервисов api/migrate) используется postgres:5432 — см. docker-compose.yml и docs/deployment.md.
DATABASE_URL=postgresql://notifications:notifications@localhost:5433/notifications
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# JWT. В production приложение не стартует с этим дефолтным значением и требует
# минимум 32 символа: сгенерировать можно через `openssl rand -base64 48`.
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_TTL=24h
# Выдача токенов через POST /auth/dev-token: нужна демо-странице и smoke-тесту.
# Токен выдаётся на любой userId и роль, поэтому на реальном проде должно быть false.
AUTH_DEV_TOKENS_ENABLED=true

# Бизнес-правила уведомлений
NOTIFICATIONS_RATE_LIMIT=10
NOTIFICATIONS_RATE_WINDOW_MS=60000
NOTIFICATIONS_DEDUP_WINDOW_MS=300000

# Транспортный лимит частоты: запросов с одного IP на один эндпоинт за окно.
# Не путать с NOTIFICATIONS_RATE_LIMIT выше — тот считает уведомления на (userId, type) в БД,
# этот режет флуд ещё до валидации и запроса к Postgres. /health исключён.
# Для прогонов k6 ставьте HTTP_RATE_LIMIT_ENABLED=false: нагрузка идёт с одного IP и упрётся
# в лимит вместо того, чтобы измерить API (см. docs/performance.md).
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT=300
HTTP_RATE_WINDOW_MS=60000

# WebSocket / delivery
WS_PATH=/ws/notifications
WS_BACKLOG_BATCH_SIZE=100
WS_BACKLOG_MAX_PAGES=10
WS_PING_INTERVAL_MS=25000
WS_PING_TIMEOUT_MS=20000
WS_MAX_HTTP_BUFFER_SIZE=1000000
WS_MAX_CONNECTIONS_PER_USER=10
WS_ACK_TIMEOUT_MS=5000
SWEEPER_INTERVAL_MS=15000
SWEEPER_MIN_AGE_MS=30000
SWEEPER_ENABLED=true

# Партиции и retention
PARTITION_LOOKAHEAD_MONTHS=2
RETENTION_MONTHS=6
RETENTION_ENABLED=false

# Зарезервировано под Socket.IO-адаптер при масштабировании на несколько инстансов.
# Сейчас не используется: presence хранится в памяти процесса (см. docs/deployment.md).
# REDIS_URL=redis://localhost:6379

# Фоновые cron (партиции, retention, purge idempotency). В Jest = false (globalSetup).
CRON_ENABLED=true
